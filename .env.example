# Copie para .env e preencha com valores reais. NUNCA commite o .env.
# Veja server/src/config/env.ts para como cada chave e lida.

# Porta HTTP do servidor Fastify.
PORT=3000

# Ambiente de execucao. Em "production" o cookie de sessao passa a exigir
# HTTPS (flag Secure); em dev fica http://localhost sem problema.
NODE_ENV=development

# Origem do SPA (Vite dev server) para onde o fluxo OAuth do Discord
# redireciona o navegador de volta apos o login/callback.
CLIENT_ORIGIN=http://localhost:5173

# OAuth2 do Discord (login de founders/admins no painel). Obrigatorias.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback

# Token do bot Discord, usado pelo painel para chamadas autenticadas a API
# do Discord (checar cargos/dono do servidor no login). Obrigatorio.
DISCORD_TOKEN=
DISCORD_GUILD_ID=

# Segredo usado para assinar o JWT de sessao e o cookie de state do OAuth.
# Gere algo aleatorio e longo, ex.: `openssl rand -hex 32`. Obrigatorio.
SESSION_SECRET=

# Caminho local para o JSON da service account do Firebase (mesmo
# Firestore do bot). Obrigatorio.
FIREBASE_SERVICE_ACCOUNT_PATH=
