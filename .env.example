# Copie para .env e preencha com valores reais. NUNCA commite o .env.
# Veja server/src/config/env.ts para como cada chave e lida.

# Porta HTTP do servidor Fastify (unica variavel validada de forma estrita nesta fase).
PORT=3000

# OAuth2 do Discord (login de founders/admins no painel) — ainda nao usado.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback

# Token do bot Discord, usado pelo painel para chamadas autenticadas a API do Discord (ex.: listar canais/cargos do servidor) — ainda nao usado.
DISCORD_TOKEN=
DISCORD_GUILD_ID=

# Segredo usado para assinar/cifrar a sessao do painel — ainda nao usado.
SESSION_SECRET=

# Caminho local para o JSON da service account do Firebase (mesmo Firestore do bot) — ainda nao usado.
FIREBASE_SERVICE_ACCOUNT_PATH=
